# Copy this file to ".env" and edit the values.
# Clinic CRM reads this file itself (see app/Core/Env.php) - PHP does not read .env automatically.

APP_ENV=local
# Set to false (and APP_ENV=production) on a real server. When true, error details are shown on screen.
APP_DEBUG=true
APP_TIMEZONE=Asia/Karachi

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=clinic_crm
DB_USER=root
DB_PASS=
# Used only by the automated tests. The test runner DROPS and recreates this database - never point it at real data.
DB_TEST_NAME=clinic_crm_test

# Minutes of inactivity before a session expires
SESSION_IDLE_MINUTES=30
# Failed sign-ins allowed per email+IP within the lockout window
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# auto = secure cookie only when the request is HTTPS; set true on production HTTPS hosting
SESSION_COOKIE_SECURE=auto

# Optional: full paths to the MySQL command-line tools used by bin/backup.php and bin/restore.php
# (only needed when they are not on your PATH, e.g. C:\xampp\mysql\bin\mysqldump.exe)
# MYSQLDUMP_PATH=
# MYSQL_PATH=
